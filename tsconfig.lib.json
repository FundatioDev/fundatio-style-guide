
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist/types",
    "noEmit": false
  },
  "include": [
    "src/components/index.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/styles/assets.d.ts"
  ],
  "exclude": ["src/components/StyleGuide"]
}