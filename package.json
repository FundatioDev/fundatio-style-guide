{
  "name": "@fundatio/ui",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/fundatio-ui.js",
  "module": "./dist/fundatio-ui.js",
  "types": "./dist/types/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/fundatio-ui.js"
    },
    "./style.css": "./dist/fundatio-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "build:app": "tsc -b && vite build --mode app",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "description": "Biblioteca de componentes reutilizáveis da FUNDATIO.",
  "keywords": [
    "fundatio",
    "react",
    "typescript",
    "ui",
    "components",
    "style-guide"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FundatioDev/fundatio-style-guide.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
